{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "tests", "scripts/*.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
